# 环境变量示例
# 请复制此文件为 .env 并填入实际值
# SECRET_KEY 必须至少 32 个字符长以满足 SHA256 安全要求

SECRET_KEY=your-32-character-or-longer-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unitokenhub
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Redis (可选)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
