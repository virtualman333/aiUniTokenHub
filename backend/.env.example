# 环境变量示例
# 请复制此文件为 .env 并填入实际值
# SECRET_KEY 必须至少 32 个字符长以满足 SHA256 安全要求

SECRET_KEY=your-32-character-or-longer-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unitokenhub
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Redis (可选)
# 只认 URL 形式这一个变量 —— 密码与库号都写进 URL 里。
# 单列 REDIS_HOST / REDIS_PORT / REDIS_PASSWORD 是**读不到**的：
# config/settings.py 只 getenv('REDIS_URL')，配了那三个等于没配，而且不报错。
# 不配就用下面这个默认值（本机、无密码、db 1）；带密码写作
#   redis://:你的密码@主机:6379/1
REDIS_URL=redis://127.0.0.1:6379/1
